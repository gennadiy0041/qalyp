{
  "name": "qalyp",
  "version": "0.2.0",
  "private": true,
  "description": "Qalyp — ИИ-нормоконтроль студенческих работ по методичке вуза",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/index.js",
    "dev": "node scripts/build.mjs && node --watch server/index.js",
    "test": "node scripts/build.mjs && node --test --test-concurrency=1 \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jsdom": "^24.1.3"
  }
}
# Ключ Anthropic API. Создайте в https://console.anthropic.com, поставьте лимит расходов.
ANTHROPIC_API_KEY=
# Модель и усилие (по умолчанию claude-opus-5-5, medium)
QALYP_MODEL=claude-opus-5-5
QALYP_EFFORT=medium
# Лимиты: запросов к ИИ с одного адреса в час и всего за сутки
QALYP_AI_PER_HOUR=30
QALYP_AI_PER_DAY=400
# Разборы методички: с одного адреса в час и всего за сутки (разбор считается и в лимитах выше)
QALYP_METHOD_PER_HOUR=6
QALYP_METHOD_PER_DAY=40
# Бюджет токенов ИИ на весь сервер за последние 24 часа (входные + выходные); исчерпан — ИИ-проверки ждут, пока расход не уменьшится
QALYP_TOKENS_PER_DAY=3000000
PORT=3000
# Необязательные (если не заданы — значения по умолчанию, указаны в скобках):
# запросов к сверке источников /api/refs с одного адреса в час (120)
# QALYP_REFS_PER_HOUR=120
# предел на весь вызов ИИ для введения и источников, мс (120000) и для методички, мс (600000)
# QALYP_AI_TIMEOUT_MS=120000
# QALYP_METHOD_TIMEOUT_MS=600000
# таймаут SDK на одну попытку, мс (120000) и число повторов при сбое, 0–5 (2)
# QALYP_AI_REQUEST_TIMEOUT_MS=120000
# QALYP_AI_RETRIES=2
# ключ OpenAlex: с ним OpenAlex спрашивается по всем записям, без него — только по статьям и записям латиницей
# QALYP_OPENALEX_KEY=
# заголовок с адресом клиента для лимитов: на Railway по умолчанию x-real-ip, вне Railway — не берётся;
# none — не брать адрес из заголовка
# QALYP_IP_HEADER=
# 0 — не писать журнал запросов в консоль
# QALYP_LOG=1
